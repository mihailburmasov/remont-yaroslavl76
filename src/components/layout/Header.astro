---
import { CONTACTS, NAV_LINKS, SITE, withBase } from "../../lib/site";

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
	const target = withBase(href);
	if (href === "/") return currentPath === target;
	return currentPath === target || currentPath.startsWith(target);
}
---

<header class="sticky top-0 z-50 border-b border-black/5 bg-paper/95 backdrop-blur">
	<div class="container-page flex h-16 items-center justify-between gap-4 md:h-20">
		<a href={withBase("/")} class="flex items-center gap-2 font-extrabold text-lg md:text-xl">
			<span
				class="flex h-9 w-9 items-center justify-center rounded bg-ink text-brand-yellow md:h-10 md:w-10"
				aria-hidden="true"
			>
				76
			</span>
			<span class="leading-tight">
				{SITE.name}
			</span>
		</a>

		<nav class="hidden lg:flex lg:items-center lg:gap-8" aria-label="Основная навигация">
			{
				NAV_LINKS.map((link) => (
					<a
						href={withBase(link.href)}
						class:list={[
							"text-sm font-semibold transition-colors hover:text-ink",
							isActive(link.href) ? "text-ink" : "text-muted",
						]}
						aria-current={isActive(link.href) ? "page" : undefined}
					>
						{link.label}
					</a>
				))
			}
		</nav>

		<div class="hidden items-center gap-4 md:flex">
			<a href={CONTACTS.phoneHref} class="text-sm font-bold whitespace-nowrap md:text-base">
				{CONTACTS.phone}
			</a>
			<a href={withBase("/kontakty/#zayavka")} class="btn btn-primary">Заказать замер</a>
		</div>

		<button
			type="button"
			id="mobile-menu-toggle"
			class="flex h-11 w-11 items-center justify-center rounded border border-black/10 lg:hidden"
			aria-expanded="false"
			aria-controls="mobile-menu"
			aria-label="Открыть меню"
		>
			<svg
				id="icon-open"
				width="22"
				height="22"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
			>
				<path d="M4 6h16M4 12h16M4 18h16"></path>
			</svg>
			<svg
				id="icon-close"
				width="22"
				height="22"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				class="hidden"
			>
				<path d="M6 6l12 12M18 6L6 18"></path>
			</svg>
		</button>
	</div>

	<div id="mobile-menu" class="hidden border-t border-black/5 bg-paper lg:hidden" role="dialog" aria-modal="true" aria-label="Меню">
		<nav class="container-page flex flex-col gap-1 py-4" aria-label="Мобильная навигация">
			{
				NAV_LINKS.map((link) => (
					<a
						href={withBase(link.href)}
						class="rounded px-2 py-3 text-base font-semibold text-graphite hover:bg-surface"
					>
						{link.label}
					</a>
				))
			}
			<div class="mt-2 flex flex-col gap-3 border-t border-black/5 pt-4">
				<a href={CONTACTS.phoneHref} class="text-lg font-bold">{CONTACTS.phone}</a>
				<a href={withBase("/kontakty/#zayavka")} class="btn btn-primary w-full">Заказать замер</a>
			</div>
		</nav>
	</div>
</header>

<script>
	const toggle = document.getElementById("mobile-menu-toggle");
	const menu = document.getElementById("mobile-menu");
	const iconOpen = document.getElementById("icon-open");
	const iconClose = document.getElementById("icon-close");

	toggle?.addEventListener("click", () => {
		const isOpen = menu?.classList.contains("hidden") === false;
		menu?.classList.toggle("hidden");
		iconOpen?.classList.toggle("hidden");
		iconClose?.classList.toggle("hidden");
		toggle.setAttribute("aria-expanded", String(!isOpen));
		toggle.setAttribute("aria-label", isOpen ? "Открыть меню" : "Закрыть меню");
	});
</script>
