---
import { withBase } from "../../lib/site";

interface Props {
	eyebrow?: string;
	title: string;
	lead?: string;
	image: string;
}

const { eyebrow, title, lead, image } = Astro.props;
---

<section class="relative overflow-hidden bg-ink text-paper">
	<img
		src={withBase(image)}
		alt=""
		width="1920"
		height="1080"
		loading="eager"
		fetchpriority="high"
		class="absolute inset-0 h-full w-full object-cover"
	/>
	<div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/80 to-ink/40" aria-hidden="true"></div>
	<div class="relative container-page py-16 md:py-24">
		{eyebrow && <p class="eyebrow text-white/60">{eyebrow}</p>}
		<h1 class="mt-3 max-w-2xl uppercase">{title}</h1>
		{lead && <p class="mt-4 max-w-2xl text-white/75">{lead}</p>}
	</div>
</section>
