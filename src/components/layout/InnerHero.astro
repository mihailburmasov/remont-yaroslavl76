---
interface Props {
	eyebrow?: string;
	title: string;
	lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<section class="bg-ink text-paper">
	<div class="container-page py-12 md:py-16">
		{eyebrow && <p class="eyebrow text-white/60">{eyebrow}</p>}
		<h1 class="mt-3 uppercase">{title}</h1>
		{lead && <p class="mt-4 max-w-2xl text-white/70">{lead}</p>}
	</div>
</section>
