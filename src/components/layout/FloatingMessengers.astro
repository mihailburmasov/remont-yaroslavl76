---
import { CONTACTS } from "../../lib/site";
---

<div class="fixed right-4 bottom-4 z-40 flex flex-col items-end gap-3 md:hidden">
	<a
		href={CONTACTS.whatsapp}
		class="flex h-14 w-14 items-center justify-center rounded-full bg-ink text-paper shadow-lg"
		aria-label="Написать в WhatsApp"
	>
		<span class="text-xs font-bold">WA</span>
	</a>
	<a
		href={CONTACTS.phoneHref}
		class="flex h-14 w-14 items-center justify-center rounded-full bg-brand-yellow text-ink shadow-lg"
		aria-label={`Позвонить ${CONTACTS.phone}`}
	>
		<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
			<path
				d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"
			></path>
		</svg>
	</a>
</div>
