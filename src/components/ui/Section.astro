---
interface Props {
	id?: string;
	tone?: "light" | "dark" | "surface";
	class?: string;
}

const { id, tone = "light", class: className = "" } = Astro.props;

const toneClass =
	tone === "dark" ? "bg-ink text-paper" : tone === "surface" ? "bg-surface" : "bg-paper";
---

<section id={id} class:list={["py-16 md:py-24", toneClass, className]}>
	<div class="container-page">
		<slot />
	</div>
</section>
