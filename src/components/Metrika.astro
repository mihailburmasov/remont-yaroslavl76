---
/**
 * Яндекс.Метрика. Пока ID не заполнен ({{METRIKA_ID}} в src/lib/site.ts), счётчик не
 * подключается — ничего лишнего не грузится и не бьёт по Lighthouse-показателям.
 */
import { METRIKA_ID } from "../lib/site";

const isConfigured = !METRIKA_ID.startsWith("{{");
---

{
	isConfigured && (
		<script is:inline define:vars={{ METRIKA_ID }}>
			(function (m, e, t, r, i, k, a) {
				m[i] =
					m[i] ||
					function () {
						(m[i].a = m[i].a || []).push(arguments);
					};
				m[i].l = 1 * new Date();
				for (var j = 0; j < document.scripts.length; j++) {
					if (document.scripts[j].src === r) {
						return;
					}
				}
				(k = e.createElement(t)),
					(a = e.getElementsByTagName(t)[0]),
					(k.async = 1),
					(k.src = r),
					a.parentNode.insertBefore(k, a);
			})(
				window,
				document,
				"script",
				"https://mc.yandex.ru/metrika/tag.js?id=" + METRIKA_ID,
				"ym",
			);

			ym(METRIKA_ID, "init", {
				ssr: true,
				webvisor: true,
				clickmap: true,
				ecommerce: "dataLayer",
				referrer: document.referrer,
				url: location.href,
				accurateTrackBounce: true,
				trackLinks: true,
			});
		</script>
	)
}

{
	isConfigured && (
		<noscript>
			<div>
				<img
					src={`https://mc.yandex.ru/watch/${METRIKA_ID}`}
					style="position:absolute; left:-9999px;"
					alt=""
				/>
			</div>
		</noscript>
	)
}
