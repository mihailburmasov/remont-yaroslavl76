---
import { withBase } from "../lib/site";

interface Props {
	beforeSrc: string;
	afterSrc: string;
	beforeAlt: string;
	afterAlt: string;
	width?: number;
	height?: number;
	label?: string;
	initial?: number;
}

const {
	beforeSrc,
	afterSrc,
	beforeAlt,
	afterAlt,
	width = 1200,
	height = 900,
	label,
	initial = 50,
} = Astro.props;
---

<div
	data-before-after
	data-baf-initial={initial}
	class="group relative w-full overflow-hidden rounded-lg bg-surface select-none"
	style={`aspect-ratio: ${width} / ${height};`}
>
	{
		label && (
			<span class="absolute top-3 left-3 z-20 rounded bg-ink/85 px-3 py-1 text-xs font-bold text-paper">
				{label}
			</span>
		)
	}

	<div data-baf-frame class="absolute inset-0 cursor-ew-resize touch-none">
		<img
			src={withBase(afterSrc)}
			alt={afterAlt}
			width={width}
			height={height}
			loading="lazy"
			decoding="async"
			class="pointer-events-none absolute inset-0 h-full w-full object-cover"
		/>
		<span
			class="absolute top-3 right-3 z-10 rounded bg-brand-yellow px-2 py-1 text-xs font-bold text-ink"
		>
			После
		</span>

		<div
			data-baf-clip
			class="pointer-events-none absolute inset-0"
			style="clip-path: inset(0 50% 0 0);"
		>
			<img
				src={withBase(beforeSrc)}
				alt={beforeAlt}
				width={width}
				height={height}
				loading="lazy"
				decoding="async"
				class="absolute inset-0 h-full w-full object-cover"
			/>
			<span class="absolute top-3 left-3 z-10 rounded bg-ink px-2 py-1 text-xs font-bold text-paper">
				До
			</span>
		</div>

		<div
			data-baf-handle
			role="slider"
			tabindex="0"
			aria-label="Перетащите, чтобы сравнить фото до и после ремонта"
			aria-valuemin="0"
			aria-valuemax="100"
			aria-valuenow="50"
			aria-orientation="horizontal"
			class="absolute top-0 bottom-0 z-20 flex w-1 -translate-x-1/2 items-center justify-center bg-paper"
			style="left: 50%;"
		>
			<span
				class="flex h-10 w-10 items-center justify-center rounded-full bg-paper text-ink shadow-lg ring-2 ring-brand-yellow"
			>
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
					<path d="M8 5l-6 7 6 7M16 5l6 7-6 7"></path>
				</svg>
			</span>
		</div>
	</div>
</div>

<script src="../scripts/before-after-slider.ts"></script>
