---
import { withBase } from "../lib/site";

interface Props {
	source?: string;
};

const { source = "mini-callback" } = Astro.props;
---

<div class="rounded-lg bg-ink px-6 py-8 text-paper md:px-10 md:py-10">
	<div class="flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between">
		<div>
			<h3 class="text-xl font-extrabold md:text-2xl">Оставьте телефон — перезвоним за 15 минут</h3>
			<p class="mt-1 text-sm text-white/70">Расскажем о ценах и сроках, без давления и навязчивых звонков.</p>
		</div>

		<form
			data-lead-form
			data-form-source={source}
			class="flex w-full flex-col gap-3 md:w-auto md:flex-row md:items-start"
			novalidate
		>
			<div class="w-full md:w-64">
				<label for={`${source}-phone`} class="sr-only">Телефон</label>
				<input
					id={`${source}-phone`}
					name="phone"
					type="tel"
					inputmode="tel"
					autocomplete="tel"
					placeholder="+7 (___) ___-__-__"
					required
					class="w-full rounded border border-white/20 bg-transparent px-4 py-3 text-base text-paper placeholder:text-white/40 outline-none focus:border-brand-yellow"
				/>
				<p data-field-error class="mt-1 hidden text-xs font-semibold text-brand-yellow"></p>
			</div>

			<div class="hidden" aria-hidden="true">
				<label for={`${source}-website`}>Сайт (не заполнять)</label>
				<input id={`${source}-website`} name="website" type="text" tabindex="-1" autocomplete="off" />
			</div>

			<button type="submit" class="btn btn-primary shrink-0">Перезвоните мне</button>
		</form>
	</div>

	<p class="mt-3 text-xs text-white/50">
		Отправляя номер, вы соглашаетесь с
		<a href={withBase("/politika-konfidencialnosti/")} class="underline hover:text-brand-yellow">
			политикой конфиденциальности
		</a>
	</p>

	<div data-form-success class="hidden text-sm font-bold text-brand-yellow" role="status">
		Спасибо! Перезвоним в течение 15 минут.
	</div>
</div>

<script src="../scripts/lead-form.ts"></script>
