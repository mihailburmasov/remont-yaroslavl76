---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import FloatingMessengers from "../components/layout/FloatingMessengers.astro";
import Metrika from "../components/Metrika.astro";
import { SITE, withBase } from "../lib/site";
import { OG_IMAGE_VERSION } from "../lib/og-image";

interface Props {
	title: string;
	description: string;
	noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? SITE.url);
const ogImage = new URL(withBase(`/og-cover.jpg?v=${OG_IMAGE_VERSION}`), Astro.site ?? SITE.url);
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>
			/**
			 * Самовосстановление после деплоя: у CSS/JS-файлов хэшированные имена, и на
			 * GitHub Pages HTML и статика кэшируются одинаково (10 минут). Если браузер
			 * открыл страницу из кэша, а после нового деплоя старый файл уже удалён —
			 * получаем 404 и «голую» вёрстку без стилей. При такой ошибке загрузки
			 * перезагружаем страницу один раз — обычный reload всегда идёт на сервер за
			 * актуальным HTML, который уже ссылается на существующие файлы.
			 */
			(function () {
				var KEY = "assetReloadTs";
				var last = Number(sessionStorage.getItem(KEY) || 0);
				if (Date.now() - last < 5000) return;
				window.addEventListener(
					"error",
					function (event) {
						var target = event.target;
						if (!target || (target.tagName !== "LINK" && target.tagName !== "SCRIPT")) return;
						sessionStorage.setItem(KEY, String(Date.now()));
						location.reload();
					},
					true,
				);
			})();
		</script>
		<link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
		<link rel="icon" type="image/png" sizes="32x32" href={withBase("/favicon-32x32.png")} />
		<link rel="icon" type="image/png" sizes="16x16" href={withBase("/favicon-16x16.png")} />
		<link rel="icon" href={withBase("/favicon.ico")} sizes="any" />
		<link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} />
		<link rel="canonical" href={canonicalURL} />
		{noindex && <meta name="robots" content="noindex,follow" />}

		<title>{title}</title>
		<meta name="description" content={description} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="1200" />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:locale" content="ru_RU" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<meta name="generator" content={Astro.generator} />
		<Metrika />
	</head>
	<body class="flex min-h-screen flex-col">
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:rounded focus:bg-brand-yellow focus:px-4 focus:py-2 focus:font-bold focus:text-ink"
		>
			Перейти к содержимому
		</a>
		<Header />
		<main id="main-content" class="flex-1">
			<slot />
		</main>
		<Footer />
		<FloatingMessengers />
	</body>
</html>
