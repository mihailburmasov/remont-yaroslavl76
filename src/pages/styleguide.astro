---
import Layout from "../layouts/Layout.astro";
import Section from "../components/ui/Section.astro";
import Button from "../components/ui/Button.astro";

const colors = [
	{ name: "Жёлтый (акцент)", varName: "--color-brand-yellow", hex: "#FFC700" },
	{ name: "Жёлтый ховер", varName: "--color-brand-yellow-light", hex: "#FFD84D" },
	{ name: "Чёрный (ink)", varName: "--color-ink", hex: "#111111" },
	{ name: "Графитовый (текст)", varName: "--color-graphite", hex: "#1F1F1F" },
	{ name: "Серый (вторичный)", varName: "--color-muted", hex: "#6B7280" },
	{ name: "Светлый фон", varName: "--color-surface", hex: "#F5F5F4" },
	{ name: "Белый", varName: "--color-paper", hex: "#FFFFFF" },
];

const typeScale = [
	{ tag: "h1", sample: "Заголовок H1" },
	{ tag: "h2", sample: "Заголовок H2" },
	{ tag: "h3", sample: "Заголовок H3" },
];
---

<Layout title="Styleguide — ПроРемонт" description="Дизайн-система сайта." noindex>
	<Section tone="light">
		<h1>Дизайн-система</h1>
		<p class="mt-4 max-w-2xl text-muted">
			Служебная страница для разработки — не индексируется. Источник цветов и правил — ТЗ
			(Промт.md).
		</p>
	</Section>

	<Section tone="surface">
		<h2>Цвета</h2>
		<div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
			{
				colors.map((color) => (
					<div class="card overflow-hidden">
						<div class="h-24" style={`background-color: ${color.hex};`} />
						<div class="p-4 text-sm">
							<p class="font-bold">{color.name}</p>
							<p class="text-muted">{color.hex}</p>
							<p class="text-muted">{color.varName}</p>
						</div>
					</div>
				))
			}
		</div>
		<p class="mt-6 text-sm text-muted">
			Правило: жёлтый — акцент (1–2 места на странице), не фон. Текст на жёлтом — всегда чёрный.
		</p>
	</Section>

	<Section tone="light">
		<h2>Типографика</h2>
		<p class="mt-2 text-muted">Шрифт: Manrope Variable, самохостинг через @fontsource.</p>
		<div class="mt-8 flex flex-col gap-6">
			{
				typeScale.map((item) => (
					<div class="border-b border-black/10 pb-6">
						<p class="mb-2 text-xs font-bold uppercase text-muted">{item.tag}</p>
						{item.tag === "h1" && <h1>{item.sample}</h1>}
						{item.tag === "h2" && <h2>{item.sample}</h2>}
						{item.tag === "h3" && <h3>{item.sample}</h3>}
					</div>
				))
			}
			<div>
				<p class="mb-2 text-xs font-bold uppercase text-muted">Body</p>
				<p class="max-w-xl">
					Основной текст набирается тем же гротеском без засечек. Плотный, хорошо читаемый на
					мобильном экране, с достаточным межстрочным интервалом.
				</p>
			</div>
		</div>
	</Section>

	<Section tone="surface">
		<h2>Кнопки</h2>
		<div class="mt-8 flex flex-wrap gap-4 rounded-lg bg-ink p-8">
			<Button variant="primary">Primary</Button>
			<Button variant="dark">Dark</Button>
			<Button variant="outline">Outline</Button>
		</div>
	</Section>

	<Section tone="light">
		<h2>Заголовок с акцентом</h2>
		<h2 class="mt-6">
			Обычный текст и{" "}
			<span class="section-heading-mark">акцентная плашка под словом</span>
		</h2>
	</Section>

	<Section tone="surface">
		<h2>Карточка</h2>
		<div class="card mt-8 max-w-sm p-6">
			<p class="eyebrow">Категория</p>
			<h3 class="mt-3">Заголовок карточки</h3>
			<p class="mt-2 text-sm text-muted">Пример текста внутри стандартной карточки .card.</p>
		</div>
	</Section>
</Layout>
