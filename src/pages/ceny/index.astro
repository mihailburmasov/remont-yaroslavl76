---
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/ui/Section.astro";
import InnerHero from "../../components/layout/InnerHero.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import MiniCallbackForm from "../../components/MiniCallbackForm.astro";
import { HERO_IMAGES, PRICE_COMPARISON, REPAIR_LEVELS, withBase } from "../../lib/site";
---

<Layout
	title="Цены на ремонт квартир и домов в Ярославле — ПРО Ремонт 76"
	description="Цены на ремонт квартир под ключ в Ярославле: бюджетный, комфорт, премиум. Сравнение уровней ремонта, что входит в стоимость за м²."
>
	<InnerHero
		eyebrow="Цены"
		title="Сколько стоит ремонт"
		lead="Три уровня ремонта под разный бюджет. Указанные цены — ориентировочные, точную смету считаем после бесплатного замера объекта."
		image={HERO_IMAGES.ceny}
	/>
	<Breadcrumbs items={[{ label: "Цены" }]} />

	<Section tone="light">
		<div class="overflow-x-auto">
			<table class="w-full min-w-[640px] border-collapse text-left text-sm">
				<thead>
					<tr class="border-b-2 border-ink">
						<th class="py-4 pr-4 font-bold">Что входит</th>
						{
							REPAIR_LEVELS.map((level) => (
								<th class="px-4 py-4 font-bold">
									{level.title}
									<span class="mt-1 block text-xs font-semibold text-muted">{level.subtitle}</span>
								</th>
							))
						}
					</tr>
				</thead>
				<tbody>
					{
						PRICE_COMPARISON.map((row, index) => (
							<tr class:list={["border-b border-black/10", index % 2 === 1 && "bg-surface/60"]}>
								<td class="py-4 pr-4 font-semibold text-graphite">{row.label}</td>
								<td class="px-4 py-4 text-muted">{row.budget}</td>
								<td class="px-4 py-4 text-muted">{row.comfort}</td>
								<td class="px-4 py-4 text-muted">{row.premium}</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>

		<p class="mt-6 max-w-2xl text-sm text-muted">
			Честно предупреждаем: финальная смета формируется только после выезда специалиста и
			замера объекта — состояние стен, коммуникаций и площадь напрямую влияют на итоговую цену.
		</p>
	</Section>

	<Section tone="surface">
		<h2 class="max-w-2xl">Из чего складывается цена</h2>
		<div class="mt-10 grid gap-6 md:grid-cols-3">
			{
				REPAIR_LEVELS.map((level) => (
					<div class="card p-6">
						<h3>{level.title}</h3>
						<p class="mt-2 text-sm text-muted">{level.description}</p>
						<a href={withBase("/kontakty/#zayavka")} class="btn btn-outline mt-6 w-full border-ink text-ink hover:bg-ink hover:text-paper">
							Заказать замер
						</a>
					</div>
				))
			}
		</div>
	</Section>

	<Section tone="light">
		<MiniCallbackForm source="ceny" />
	</Section>
</Layout>
