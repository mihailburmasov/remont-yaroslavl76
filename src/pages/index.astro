---
import Layout from "../layouts/Layout.astro";
import Section from "../components/ui/Section.astro";
import Button from "../components/ui/Button.astro";
import BeforeAfterSlider from "../components/BeforeAfterSlider.astro";
import ContactForm from "../components/ContactForm.astro";
import MiniCallbackForm from "../components/MiniCallbackForm.astro";
import {
	ADVANTAGES,
	CONTACTS,
	FAQ,
	HERO_IMAGES,
	REPAIR_LEVELS,
	SERVICE_AREA_CITIES,
	STATS,
	withBase,
	WORK_STAGES,
} from "../lib/site";

const TRUST_BADGES = [
	{ title: "Сроки", subtitle: "зафиксированы в договоре" },
	{ title: "Фото и видео", subtitle: "отчёты по этапам работ" },
	{ title: "На связи", subtitle: "24/7 по телефону и в мессенджерах" },
	{ title: "Гарантия", subtitle: "5 лет на выполненные работы" },
];

const QUICK_ACTIONS = [
	{
		title: "Хочу ремонт под ключ",
		subtitle: "Оставить заявку",
		href: withBase("/kontakty/#zayavka"),
	},
	{
		title: "Бесплатная консультация",
		subtitle: "Написать в WhatsApp",
		href: CONTACTS.whatsapp,
	},
	{
		title: "Каталог проектов",
		subtitle: "Смотреть портфолио",
		href: withBase("/portfolio/"),
	},
	{
		title: "Рассчитать стоимость",
		subtitle: "Смотреть цены",
		href: withBase("/ceny/"),
	},
];

const TESTIMONIALS = [
	{
		initials: "АК",
		name: "Анна К.",
		object: "Однокомнатная квартира, 34 м²",
		text: "Делали косметический ремонт перед сдачей квартиры в аренду. Уложились в три недели, как и обещали в договоре, никаких доплат сверху сметы. Бригада убирала за собой каждый день.",
	},
	{
		initials: "ДЕ",
		name: "Дмитрий и Елена П.",
		object: "Двухкомнатная квартира, 54 м²",
		text: "Объединяли кухню с гостиной по перепланировке — переживали за сроки согласований, но бригада всё решила сама. Присылали фотоотчёты каждую неделю, было видно, что происходит на объекте.",
	},
	{
		initials: "СМ",
		name: "Сергей М.",
		object: "Частный дом, 180 м²",
		text: "Делали ремонт по дизайн-проекту с нуля. Понравилось, что сначала показали результат в 3D — не было сюрпризов на приёмке. Дизайнер вела объект до последней розетки.",
	},
];

const portfolioExamples = [
	{
		slug: "kvartira-komfort-kukhnya",
		title: "Кухня-гостиная, 24 м²",
		level: "Комфорт",
	},
	{
		slug: "dom-premium-gostinaya",
		title: "Гостиная в частном доме, 38 м²",
		level: "Премиум",
	},
	{
		slug: "kvartira-byudzhet-vannaya",
		title: "Санузел, 5 м²",
		level: "Бюджетный",
	},
];

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "HomeAndConstructionBusiness",
	name: "ПРО Ремонт 76",
	image: new URL(withBase("/og-cover.jpg"), Astro.site).toString(),
	url: Astro.url.toString(),
	telephone: "+79092800055",
	priceRange: "6 500–22 000 ₽/м²",
	areaServed: ["Ярославль", "Рыбинск", "Тутаев", "Переславль-Залесский", "Ростов", "Углич"],
	address: {
		"@type": "PostalAddress",
		streetAddress: CONTACTS.address,
		addressLocality: "Ярославль",
		addressCountry: "RU",
	},
	openingHours: "Mo-Su 09:00-17:30",
};

const faqJsonLd = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: FAQ.map((item) => ({
		"@type": "Question",
		name: item.question,
		acceptedAnswer: { "@type": "Answer", text: item.answer },
	})),
};
---

<Layout
	title="Ремонт квартир и домов под ключ в Ярославле — ПРО Ремонт 76"
	description="Ремонт квартир и частных домов «под ключ» в Ярославле и области: косметический, капитальный, дизайнерский. Фиксированная смета, договор, гарантия."
>
	<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
	<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline />

	<!-- HERO -->
	<section class="relative flex min-h-[calc(100vh-4rem)] flex-col justify-center overflow-hidden bg-ink text-paper md:min-h-[calc(100vh-5rem)]">
		<img
			src={withBase(HERO_IMAGES.home)}
			alt="Ремонт квартиры под ключ — готовый интерьер"
			width="1920"
			height="1080"
			loading="eager"
			fetchpriority="high"
			class="absolute inset-0 h-full w-full object-cover"
		/>
		<div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/85 to-ink/55" aria-hidden="true"></div>

		<div class="relative container-page grid gap-[clamp(1.5rem,4vh,2rem)] py-[clamp(1.5rem,5vh,4rem)] md:grid-cols-[1.15fr_0.85fr] md:items-center">
			<div>
				<p class="inline-flex items-center gap-1.5 rounded-full border border-white/20 bg-black/30 px-3 py-1.5 text-xs font-bold uppercase tracking-wide text-white/85">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="shrink-0">
						<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
						<circle cx="12" cy="10" r="3" />
					</svg>
					Ярославль и область
				</p>
				<h1 class="mt-[clamp(0.75rem,2vh,1.25rem)] text-3xl uppercase md:text-4xl lg:text-5xl">
					Ремонт квартир и домов<br />
					<span class="relative -rotate-1 mt-2 inline-block">
						<svg
							class="absolute inset-0 h-full w-full -z-10"
							viewBox="0 0 220 70"
							preserveAspectRatio="none"
							aria-hidden="true"
						>
							<path
								d="M6,32 C4,18 14,8 32,6 C90,-2 160,0 206,10 C216,13 218,24 214,34 C218,46 214,58 200,62 C140,70 60,68 16,60 C4,57 2,46 6,38 C1,35 3,34 6,32 Z"
								fill="#FFC700"
							/>
						</svg>
						<span class="relative block px-3 py-2 text-ink">под ключ</span>
					</span>
				</h1>
				<p class="mt-[clamp(0.75rem,2vh,1.25rem)] text-xl font-extrabold text-brand-yellow md:text-2xl lg:text-3xl">
					ПроРемонт — делаем ремонт лёгким!
				</p>
				<p class="mt-[clamp(0.75rem,2vh,1.5rem)] max-w-lg text-base text-white/75 md:text-lg">
					Работаем в любом бюджете — от косметического обновления до дизайнерского ремонта под
					ключ. Фиксируем смету в договоре и не меняем цену на середине объекта.
				</p>
				<div class="mt-[clamp(1rem,3vh,2.5rem)] flex flex-wrap gap-4">
					<Button href={withBase("/kontakty/#zayavka")} variant="primary">Заказать бесплатный замер</Button>
					<Button href={CONTACTS.phoneHref} variant="outline">{CONTACTS.phone}</Button>
				</div>

				<dl class="mt-[clamp(1.5rem,4.5vh,3.5rem)] grid grid-cols-2 gap-4 sm:grid-cols-4 sm:gap-6">
					{
						STATS.map((stat) => (
							<div class="min-w-0">
								<dt class="sr-only">{stat.label}</dt>
								<dd class="text-xl font-extrabold break-words text-brand-yellow md:text-2xl">
									{stat.value}
								</dd>
								<dd class="mt-1 text-xs text-white/60">{stat.label}</dd>
							</div>
						))
					}
				</dl>
			</div>

			<div class="grid grid-cols-2 gap-3">
				{
					TRUST_BADGES.map((badge) => (
						<div class="rounded-lg border border-white/15 bg-black/35 p-[clamp(0.875rem,2.5vh,1.5rem)] backdrop-blur-sm">
							<p class="text-sm font-extrabold text-brand-yellow">{badge.title}</p>
							<p class="mt-1 text-xs text-white/70">{badge.subtitle}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- БЫСТРЫЕ ДЕЙСТВИЯ -->
	<Section tone="dark">
		<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
			{
				QUICK_ACTIONS.map((action) => (
					<a
						href={action.href}
						class="rounded-lg border border-white/10 bg-white/[0.03] p-5 transition-colors hover:border-brand-yellow"
					>
						<p class="font-bold text-paper">{action.title}</p>
						<p class="mt-2 text-sm font-semibold text-brand-yellow">{action.subtitle} →</p>
					</a>
				))
			}
		</div>
	</Section>

	<!-- ТРИ УРОВНЯ РЕМОНТА -->
	<Section tone="light">
		<p class="eyebrow">Работаем в любом бюджете</p>
		<h2 class="mt-3 max-w-2xl">
			Три уровня ремонта —{" "}
			<span class="section-heading-mark">один надёжный подрядчик</span>
		</h2>
		<p class="mt-4 max-w-2xl text-muted">
			Выбираете уровень исходя из бюджета и задач, мы подбираем материалы, состав бригады и сроки
			под него — без компромиссов в качестве работ.
		</p>

		<div class="mt-10 grid gap-6 md:grid-cols-3">
			{
				REPAIR_LEVELS.map((level) => (
					<div
						class:list={[
							"card flex flex-col p-6 md:p-8",
							level.accent && "border-2 border-ink",
						]}
					>
						{level.accent && (
							<span class="mb-4 inline-flex w-fit rounded bg-brand-yellow px-3 py-1 text-xs font-bold text-ink">
								Популярный выбор
							</span>
						)}
						<h3>{level.title}</h3>
						<p class="text-sm font-semibold text-muted">{level.subtitle}</p>
						<p class="mt-4 text-sm text-graphite">{level.description}</p>

						<p class="mt-6 text-3xl font-extrabold">
							от {level.price}
							<span class="text-base font-semibold text-muted"> {level.priceUnit}</span>
						</p>

						<ul class="mt-6 flex flex-1 flex-col gap-3 text-sm">
							{level.features.map((feature) => (
								<li class="flex items-start gap-2">
									<svg
										width="18"
										height="18"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2.5"
										class="mt-0.5 shrink-0 text-brand-yellow"
									>
										<path d="M5 13l4 4L19 7" />
									</svg>
									{feature}
								</li>
							))}
						</ul>

						<Button href={withBase("/ceny/")} variant={level.accent ? "dark" : "outline"} class={level.accent ? "hover:bg-brand-yellow hover:text-ink" : "mt-8 border-ink text-ink hover:border-brand-yellow hover:bg-brand-yellow hover:text-ink"}>
							Подробнее о тарифе
						</Button>
					</div>
				))
			}
		</div>

		<p class="mt-8 text-sm text-muted">
			Указанные цены — ориентировочные. Точную смету считаем после бесплатного замера объекта.
		</p>
	</Section>

	<!-- ДО / ПОСЛЕ -->
	<Section tone="surface">
		<p class="eyebrow">Наши объекты</p>
		<h2 class="mt-3 max-w-2xl">
			Смотрите сами —{" "}
			<span class="section-heading-mark">какой бывает разница</span>
		</h2>
		<p class="mt-4 max-w-2xl text-muted">
			Потяните за разделитель, чтобы сравнить фото до и после ремонта. Фото — демонстрационные,
			реальные объекты добавим после согласования с клиентами.
		</p>

		<div class="mt-10 grid gap-8 md:grid-cols-3">
			{
				portfolioExamples.map((item) => (
					<div>
						<BeforeAfterSlider
							beforeSrc={`/images/portfolio/${item.slug}-do.webp`}
							afterSrc={`/images/portfolio/${item.slug}-posle.webp`}
							beforeAlt={`${item.title} — до ремонта`}
							afterAlt={`${item.title} — после ремонта`}
							width={1200}
							height={900}
						/>
						<h3 class="mt-4 text-base font-bold">{item.title}</h3>
						<p class="text-sm text-muted">Уровень ремонта: {item.level}</p>
					</div>
				))
			}
		</div>

		<div class="mt-10">
			<Button href={withBase("/portfolio/")} variant="dark">Всё портфолио</Button>
		</div>
	</Section>

	<!-- ЭТАПЫ РАБОТЫ -->
	<Section tone="light">
		<p class="eyebrow">Как мы работаем</p>
		<h2 class="mt-3 max-w-2xl">
			От замера до сдачи ключей —{" "}
			<span class="section-heading-mark">шесть понятных этапов</span>
		</h2>

		<div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
			{
				WORK_STAGES.map((stage) => (
					<div class="flex gap-4">
						<span class="text-3xl font-extrabold text-brand-yellow">{stage.number}</span>
						<div>
							<h3 class="text-base font-bold">{stage.title}</h3>
							<p class="mt-2 text-sm text-muted">{stage.description}</p>
						</div>
					</div>
				))
			}
		</div>
	</Section>

	<!-- ПРЕИМУЩЕСТВА -->
	<Section tone="dark">
		<p class="eyebrow text-white/60">Почему выбирают нас</p>
		<h2 class="mt-3 max-w-2xl">
			Ремонт без нервотрёпки —{" "}
			<span class="text-brand-yellow">и без сюрпризов в смете</span>
		</h2>

		<div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
			{
				ADVANTAGES.map((advantage) => (
					<div class="border-t-2 border-brand-yellow pt-4">
						<h3 class="text-base font-bold text-paper">{advantage.title}</h3>
						<p class="mt-2 text-sm text-white/65">{advantage.description}</p>
					</div>
				))
			}
		</div>
	</Section>

	<!-- МИНИ-ФОРМА №1 -->
	<Section tone="light">
		<MiniCallbackForm source="mini-callback-hero" />
	</Section>

	<!-- ОТЗЫВЫ -->
	<Section tone="surface">
		<p class="eyebrow">Отзывы</p>
		<h2 class="mt-3 max-w-2xl">
			Что говорят те,{" "}
			<span class="section-heading-mark">кто уже сделал ремонт с нами</span>
		</h2>

		<div class="mt-10 grid gap-6 md:grid-cols-3">
			{
				TESTIMONIALS.map((testimonial) => (
					<figure class="card flex flex-col p-6">
						<div class="flex items-center gap-3">
							<div class="flex h-12 w-12 items-center justify-center rounded-full bg-ink text-sm font-bold text-brand-yellow">
								{testimonial.initials}
							</div>
							<div>
								<figcaption class="text-sm font-bold">{testimonial.name}</figcaption>
								<p class="text-xs text-muted">{testimonial.object}</p>
							</div>
						</div>
						<blockquote class="mt-4 flex-1 text-sm text-graphite">{testimonial.text}</blockquote>
					</figure>
				))
			}
		</div>
		<p class="mt-6 text-sm text-muted">
			Отзывы — демонстрационные, для примера. Реальные отзывы клиентов добавим с их согласия.
		</p>
	</Section>

	<!-- ГЕОГРАФИЯ -->
	<Section tone="light">
		<p class="eyebrow">География работы</p>
		<h2 class="mt-3 max-w-2xl">Выезжаем по всей Ярославской области</h2>
		<p class="mt-4 max-w-2xl text-muted">
			Основные объекты — в Ярославле, но бригады регулярно выезжают и в другие города области.
		</p>
		<ul class="mt-6 flex flex-wrap gap-3">
			{
				SERVICE_AREA_CITIES.map((city) => (
					<li class="rounded-full border border-black/10 px-4 py-2 text-sm font-semibold">
						{city}
					</li>
				))
			}
		</ul>
	</Section>

	<!-- FAQ -->
	<Section tone="surface">
		<p class="eyebrow">Частые вопросы</p>
		<h2 class="mt-3 max-w-2xl">Отвечаем до того, как вы спросите</h2>

		<div class="mt-10 divide-y divide-black/10 border-t border-b border-black/10">
			{
				FAQ.map((item) => (
					<details class="group py-5">
						<summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-bold">
							{item.question}
							<svg
								width="20"
								height="20"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								class="shrink-0 transition-transform group-open:rotate-45"
							>
								<path d="M12 5v14M5 12h14" />
							</svg>
						</summary>
						<p class="mt-3 text-sm text-muted">{item.answer}</p>
					</details>
				))
			}
		</div>
	</Section>

	<!-- ФИНАЛЬНАЯ ФОРМА -->
	<Section tone="dark" id="zayavka">
		<div class="grid gap-12 md:grid-cols-2 md:items-start">
			<div>
				<p class="eyebrow text-white/60">Бесплатный замер</p>
				<h2 class="mt-3">
					Начнём с бесплатного{" "}
					<span class="text-brand-yellow">замера и консультации</span>
				</h2>
				<p class="mt-4 max-w-md text-white/70">
					Оставьте заявку — приедем на объект, обсудим задачи и посчитаем предварительную смету
					по выбранному уровню ремонта.
				</p>
				<div class="mt-8 flex flex-col gap-3 text-sm text-white/80">
					<a href={CONTACTS.phoneHref} class="text-lg font-bold text-paper">{CONTACTS.phone}</a>
					<span>{CONTACTS.address}</span>
					<span>{CONTACTS.workingHours}</span>
				</div>
			</div>
			<ContactForm source="homepage-final" />
		</div>
	</Section>
</Layout>
