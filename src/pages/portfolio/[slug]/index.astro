---
import Layout from "../../../layouts/Layout.astro";
import Section from "../../../components/ui/Section.astro";
import Breadcrumbs from "../../../components/layout/Breadcrumbs.astro";
import BeforeAfterSlider from "../../../components/BeforeAfterSlider.astro";
import ContactForm from "../../../components/ContactForm.astro";
import { PROJECTS } from "../../../lib/projects";
import { withBase } from "../../../lib/site";

export function getStaticPaths() {
	return PROJECTS.map((project) => ({
		params: { slug: project.slug },
		props: { project },
	}));
}

const { project } = Astro.props;

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "ImageObject",
	name: project.title,
	description: project.description,
	contentUrl: new URL(withBase(project.rooms[0].afterSrc), Astro.site).toString(),
};
---

<Layout
	title={`${project.title} — портфолио ПроРемонт`}
	description={project.description}
>
	<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

	<section class="relative overflow-hidden bg-ink text-paper">
		<img
			src={withBase(project.rooms[0].afterSrc)}
			alt=""
			width="1920"
			height="1080"
			loading="eager"
			fetchpriority="high"
			class="absolute inset-0 h-full w-full object-cover"
		/>
		<div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/85 to-ink/45" aria-hidden="true"></div>
		<div class="relative container-page py-12 md:py-16">
			<p class="eyebrow text-white/60">Портфолио</p>
			<h1 class="mt-3 uppercase">{project.title}</h1>
			<dl class="mt-8 grid grid-cols-2 gap-6 sm:grid-cols-4">
				<div>
					<dt class="text-xs text-white/50">Объект</dt>
					<dd class="mt-1 font-bold">{project.objectType}</dd>
				</div>
				<div>
					<dt class="text-xs text-white/50">Уровень</dt>
					<dd class="mt-1 font-bold">{project.level}</dd>
				</div>
				<div>
					<dt class="text-xs text-white/50">Площадь</dt>
					<dd class="mt-1 font-bold">{project.area}</dd>
				</div>
				<div>
					<dt class="text-xs text-white/50">Срок работ</dt>
					<dd class="mt-1 font-bold">{project.term}</dd>
				</div>
			</dl>
		</div>
	</section>
	<Breadcrumbs items={[{ label: "Портфолио", href: "/portfolio/" }, { label: project.title }]} />

	<Section tone="light">
		<div class="max-w-3xl">
			<h2>О проекте</h2>
			<p class="mt-4 text-graphite">{project.description}</p>
			<p class="mt-4 text-sm text-muted">Бюджет проекта: {project.budgetRange}</p>
		</div>

		<div class="mt-12 grid gap-10 md:grid-cols-2">
			{
				project.rooms.map((room) => (
					<div>
						<BeforeAfterSlider
							beforeSrc={room.beforeSrc}
							afterSrc={room.afterSrc}
							beforeAlt={`${room.title} — до ремонта`}
							afterAlt={`${room.title} — после ремонта`}
							label={room.title}
						/>
					</div>
				))
			}
		</div>
	</Section>

	<Section tone="surface">
		<h2 class="max-w-2xl">Похожий проект хотите себе?</h2>
		<div class="mt-8 max-w-xl">
			<ContactForm source={`project-${project.slug}`} title="Оставьте заявку на замер" />
		</div>
	</Section>

	<Section tone="dark">
		<h2 class="max-w-2xl">Другие проекты</h2>
		<div class="mt-8 flex flex-wrap gap-3">
			{
				PROJECTS.filter((p) => p.slug !== project.slug).map((p) => (
					<a
						href={withBase(`/portfolio/${p.slug}/`)}
						class="rounded-full border border-white/20 px-4 py-2 text-sm font-semibold text-paper hover:border-brand-yellow hover:text-brand-yellow"
					>
						{p.title}
					</a>
				))
			}
			<a
				href={withBase("/portfolio/")}
				class="rounded-full bg-brand-yellow px-4 py-2 text-sm font-bold text-ink"
			>
				Всё портфолио
			</a>
		</div>
	</Section>
</Layout>
