---
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/ui/Section.astro";
import InnerHero from "../../components/layout/InnerHero.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { PROJECTS } from "../../lib/projects";
import { CONTACTS, HERO_IMAGES } from "../../lib/site";

const objectTypes = ["Квартира", "Дом"];
const levels = ["Бюджетный", "Косметический", "Дизайнерский"];
---

<Layout
	title="Портфолио — примеры ремонта квартир и домов в Ярославле"
	description="Портфолио выполненных объектов ПроРемонт: ремонт квартир и домов в Ярославле с фото до и после."
>
	<InnerHero
		eyebrow="Портфолио"
		title="Наши объекты"
		lead="Фильтруйте по типу объекта и уровню ремонта, кликайте на фото, чтобы увидеть крупнее."
		image={HERO_IMAGES.portfolio}
	/>
	<Breadcrumbs items={[{ label: "Портфолио" }]} />

	<Section tone="light">
		<div class="flex flex-wrap gap-6">
			<div data-filter-group="objectType" class="flex flex-wrap items-center gap-2">
				<span class="text-xs font-bold uppercase text-muted">Объект:</span>
				<button type="button" data-filter-value="all" aria-pressed="true" class="btn btn-dark px-4 py-2 text-xs">
					Все
				</button>
				{
					objectTypes.map((type) => (
						<button
							type="button"
							data-filter-value={type}
							aria-pressed="false"
							class="btn bg-transparent border border-black/15 px-4 py-2 text-xs text-graphite"
						>
							{type}
						</button>
					))
				}
			</div>

			<div data-filter-group="level" class="flex flex-wrap items-center gap-2">
				<span class="text-xs font-bold uppercase text-muted">Уровень:</span>
				<button type="button" data-filter-value="all" aria-pressed="true" class="btn btn-dark px-4 py-2 text-xs">
					Все
				</button>
				{
					levels.map((level) => (
						<button
							type="button"
							data-filter-value={level}
							aria-pressed="false"
							class="btn bg-transparent border border-black/15 px-4 py-2 text-xs text-graphite"
						>
							{level}
						</button>
					))
				}
			</div>
		</div>

		<div data-portfolio-grid class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
			{PROJECTS.map((project) => <ProjectCard project={project} />)}
		</div>

		<p data-portfolio-empty hidden class="mt-10 text-center text-muted">
			По этому сочетанию фильтров пока нет проектов — уберите один из фильтров.
		</p>

		<div class="mt-14 flex justify-center">
			<a
				href={CONTACTS.vk}
				target="_blank"
				rel="noopener noreferrer"
				class="group flex max-w-2xl flex-col items-center gap-5 rounded-lg border border-black/10 bg-surface px-8 py-8 text-center shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-lg sm:flex-row sm:text-left"
			>
				<span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-[#0077FF] font-bold text-white shadow-md transition-transform duration-200 group-hover:scale-110">
					VK
				</span>
				<div>
					<p class="text-base text-graphite">
						Это лишь часть наших работ. С полным портфолио с детальными фото, видео и описанием
						этапов ремонта вы можете ознакомиться в нашей группе ВКонтакте.
					</p>
					<span class="btn btn-dark mt-4 bg-[#0077FF] group-hover:bg-[#0066dd]">
						Смотреть в группе ВКонтакте
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="shrink-0 transition-transform duration-200 group-hover:translate-x-1">
							<path d="M5 12h14M13 6l6 6-6 6" />
						</svg>
					</span>
				</div>
			</a>
		</div>
	</Section>
</Layout>

<script src="../../scripts/portfolio-filter.ts"></script>
<script src="../../scripts/lightbox.ts"></script>
