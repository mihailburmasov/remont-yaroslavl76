---
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/ui/Section.astro";
import InnerHero from "../../components/layout/InnerHero.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import MiniCallbackForm from "../../components/MiniCallbackForm.astro";
import { GUARANTEES, SITE, STATS, TEAM, withBase, WORK_STAGES } from "../../lib/site";
---

<Layout
	title="О компании — ПРО Ремонт 76, ремонт квартир и домов в Ярославле"
	description="ПРО Ремонт 76 — ремонт квартир и домов в Ярославле. Команда, подход к работе, гарантии и договор."
>
	<InnerHero
		eyebrow="О компании"
		title={SITE.name}
		lead={SITE.description}
	/>
	<Breadcrumbs items={[{ label: "О компании" }]} />

	<Section tone="light">
		<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
			{
				STATS.map((stat) => (
					<div class="card p-6 text-center">
						<p class="break-words text-2xl font-extrabold text-ink md:text-3xl">{stat.value}</p>
						<p class="mt-1 text-xs text-muted">{stat.label}</p>
					</div>
				))
			}
		</div>
	</Section>

	<Section tone="surface">
		<p class="eyebrow">Подход к работе</p>
		<h2 class="mt-3 max-w-2xl">Как мы ведём объект от замера до сдачи</h2>
		<div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
			{
				WORK_STAGES.map((stage) => (
					<div class="flex gap-4">
						<span class="text-3xl font-extrabold text-brand-yellow">{stage.number}</span>
						<div>
							<h3 class="text-base font-bold">{stage.title}</h3>
							<p class="mt-2 text-sm text-muted">{stage.description}</p>
						</div>
					</div>
				))
			}
		</div>
	</Section>

	<Section tone="light">
		<p class="eyebrow">Команда</p>
		<h2 class="mt-3 max-w-2xl">Кто будет вести ваш объект</h2>
		<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
			{
				TEAM.map((member) => (
					<div class="card overflow-hidden">
						<img
							src={withBase(member.photo)}
							alt={member.name}
							width="600"
							height="600"
							loading="lazy"
							decoding="async"
							class="aspect-square w-full object-cover"
						/>
						<div class="p-4">
							<p class="font-bold">{member.name}</p>
							<p class="text-xs font-semibold text-muted">{member.role}</p>
							<p class="mt-2 text-sm text-graphite">{member.bio}</p>
						</div>
					</div>
				))
			}
		</div>
	</Section>

	<Section tone="dark">
		<p class="eyebrow text-white/60">Гарантии и документы</p>
		<h2 class="mt-3 max-w-2xl">Работаем официально и отвечаем за результат</h2>
		<div class="mt-10 grid gap-8 sm:grid-cols-2">
			{
				GUARANTEES.map((item) => (
					<div class="border-t-2 border-brand-yellow pt-4">
						<h3 class="text-base font-bold text-paper">{item.title}</h3>
						<p class="mt-2 text-sm text-white/65">{item.description}</p>
					</div>
				))
			}
		</div>
		<p class="mt-10 text-sm text-white/60">
			Реквизиты: {SITE.legalName}, ИНН {"{{INN}}"}. Работаем по договору подряда, образец
			предоставляем перед началом работ.
		</p>
	</Section>

	<Section tone="surface">
		<MiniCallbackForm source="o-kompanii" />
	</Section>
</Layout>
